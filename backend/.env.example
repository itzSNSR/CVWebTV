# CineVault TV — backend configuration
#
# HOW TO USE
#   1. Copy this file to  backend/.env
#   2. Fill in MOVIEBOX_APP_KEY (required) and, if your region needs it,
#      MOVIEBOX_BASE_URL / MOVIEBOX_SESSION. Signing options are documented
#      in the request-signing block below.
#   3. Start the server:  node backend/server.js
#   4. Check it:          http://localhost:8787/api/health
#      "configured": true means the app will ask MovieBox for the catalogue.
#
# backend/.env is read automatically and is never served to the browser.
# Real environment variables take precedence over this file.
# Never commit backend/.env.

# ---------------------------------------------------------------- provider
# moviebox = production (default).
# fixture  = deterministic local test data, used only by the automated tests.
CVTV_PROVIDER=moviebox

# ------------------------------------------------- MovieBox (REQUIRED key)
# Where the TV app gets its catalogue from. The default below is the base URL
# used by the Android client (MovieBoxRetrofitClient.BASE_URL), so you only
# need MOVIEBOX_BASE_URL if your authorised access uses a different host.
MOVIEBOX_BASE_URL=https://api.inmoviebox.com/

# ------------------------------------------------------ request signing
# MovieBox authenticates every request with HMAC-MD5 over a canonical string
# built from the method, signed headers, body hash, timestamp and sorted query.
# The module is backend/auth/movieboxSigner.js and uses only Node's built-in
# crypto. These values stay on the server; they are never sent to the browser.
#
# REQUIRED for the live provider. Paste your authorised application key here.
# Leave it empty and catalogue routes answer 503 provider_not_configured with
# this variable name in the message. For local development, the mock provider
# in backend/test/ uses the TEST key in backend/test/fixtures/test-credentials.js;
# that key is fake and never works against the live service.
MOVIEBOX_APP_KEY=

# How MOVIEBOX_APP_KEY is encoded: auto | base64 | utf8.
# auto (default) base64-decodes a key that yields at least 8 bytes and falls
# back to the literal string, matching the Android client.
MOVIEBOX_APP_KEY_ENCODING=auto

# Signature scheme from the authorised provider API. Only hmac-md5 is defined.
MOVIEBOX_SIGNING_SCHEME=hmac-md5

# x-tr-signature is <timestamp>|<version>|<base64 HMAC>.
MOVIEBOX_SIGNATURE_VERSION=2

# Leave true for the live provider. Set to false only for a local mock endpoint
# that does not verify signatures; the live provider rejects unsigned requests.
MOVIEBOX_SIGNING_ENABLED=true

# ------------------------------------------------- guest session (details/play)
# Details, seasons and playback need a short-lived MovieBox visitor token. The
# backend obtains it automatically from this endpoint, caches it in memory and
# sends it as Authorization: Bearer. It is never written to disk or sent to the
# television. Catalogue browsing works even if guest login is disabled.
MOVIEBOX_GUEST_LOGIN=true
MOVIEBOX_AUTH_BASE_URL=https://api.inmoviebox.com/
MOVIEBOX_AUTH_HOST=api.inmoviebox.com

# Optional. Public client identity used by the newer signed request profile.
# The defaults match the APK's LocalMovieBoxServer and normally need no change.
MOVIEBOX_APP_ID=4U01pxRu278GqCZKY9
MOVIEBOX_OFFICIAL_VERSION=4.0.02
MOVIEBOX_OFFICIAL_VERSION_CODE=50020126
MOVIEBOX_OS_VERSION=14
MOVIEBOX_API_SP_CODE=404

# Optional. Logged-in MovieBox account token (the APK's user_auth_token) for
# titles the guest/UGC path cannot access. The automatic guest token is enough
# for the normal catalogue; the backend also resolves MovieBox's 23-second
# update placeholder through UGC. Leave blank unless an account is needed.
# Never commit this value.
MOVIEBOX_USER_TOKEN=

# Optional. Session cookie, only if your authorised access requires one.
# It is sent as the Cookie header. Keep it on the server.
MOVIEBOX_SESSION=

# Optional. Region used in the device header and in the `host` query value.
MOVIEBOX_REGION=IN
# Optional. Value of the `host` parameter of subject-api/get.
# Default matches the Android client.
MOVIEBOX_HOST=api.inmoviebox.com

# Optional device identity used in the X-Client-Info header. The defaults are
# the public constants the Android client sends; override only if needed.
MOVIEBOX_DEVICE_ID=
MOVIEBOX_GAID=
MOVIEBOX_SP_CODE=

# Optional. Catalogue category ids (defaults match the Android client).
MOVIEBOX_CAT_MOVIES=2
MOVIEBOX_CAT_SERIES=5

# ------------------------------------------------- OTT platform filters (opt)
# Optional. A title only gets a Netflix / Prime Video / JioHotstar / Apple TV+
# badge when TMDB reports a real watch-provider match for your region. Without
# a key the platform filters return nothing and the UI explains why.
TMDB_API_KEY=
TMDB_REGION=IN

# ------------------------------------------------------------------- server
PORT=8787
HOST=0.0.0.0
# Your public HTTPS origin, e.g. https://tv.example.com
CVTV_PUBLIC_ORIGIN=
# Comma separated origins allowed to call the API when the frontend is hosted
# separately, e.g. https://yoursite.github.io
CVTV_ALLOWED_ORIGINS=
